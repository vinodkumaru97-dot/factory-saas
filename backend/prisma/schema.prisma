generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  role          String
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
}

model RawMaterial {
  rm_id         Int                @id @default(autoincrement())
  rm_name       String
  category      String?
  unit          String
  min_stock_qty Float?
  notes         String?

  stockMovements RMStockMovement[]
  batchUsages    BatchRawMaterial[]
}

model Product {
  product_id       Int                       @id @default(autoincrement())
  product_name     String
  category         String?
  default_unit     String
  hsn_code         String?
  shelf_life_days  Int?

  batches          Batch[]
  packings         Packing[]
  fgStockMovements FGStockMovement[]
  orderItems       OrderItem[]
  returns          Return[]
}

model Customer {
  customer_id   Int      @id @default(autoincrement())
  customer_name String
  type          String?
  contact_no    String?
  whatsapp_no   String?
  email         String?
  address       String?
  gstin         String?
  remarks       String?

  orders    Order[]
  dispatches Dispatch[]
  invoices  Invoice[]
}

model RMStockMovement {
  id             Int       @id @default(autoincrement())
  txn_date       DateTime
  rm_id          Int
  txn_type       String
  qty_in         Float     @default(0)
  qty_out        Float     @default(0)
  rate_per_unit  Float?
  total_amount   Float?
  reference_type String?
  reference_id   Int?

  rawMaterial RawMaterial @relation(fields: [rm_id], references: [rm_id])
}

model Batch {
  batch_id            Int       @id @default(autoincrement())
  batch_code          String    @unique
  batch_date          DateTime
  product_id          Int
  expected_output_qty Float?
  actual_output_qty   Float?
  byproduct_qty       Float?
  yield_pct           Float?
  operator_name       String?
  remarks             String?

  product      Product           @relation(fields: [product_id], references: [product_id])
  rawMaterials BatchRawMaterial[]
  packings     Packing[]
}

model BatchRawMaterial {
  id       Int    @id @default(autoincrement())
  batch_id Int
  rm_id    Int
  qty_used Float

  batch       Batch       @relation(fields: [batch_id], references: [batch_id])
  rawMaterial RawMaterial @relation(fields: [rm_id], references: [rm_id])
}

model Packing {
  packing_id       Int       @id @default(autoincrement())
  packing_date     DateTime
  batch_id         Int
  product_id       Int
  pack_size        Float
  pack_unit        String
  no_of_packs      Int
  total_qty_packed Float
  remarks          String?

  batch   Batch   @relation(fields: [batch_id], references: [batch_id])
  product Product @relation(fields: [product_id], references: [product_id])
}

model FGStockMovement {
  id             Int       @id @default(autoincrement())
  movement_date  DateTime
  product_id     Int
  pack_size      Float
  pack_unit      String
  txn_type       String
  qty_packs_in   Int       @default(0)
  qty_packs_out  Int       @default(0)
  reference_type String?
  reference_id   Int?
  remarks        String?

  product Product @relation(fields: [product_id], references: [product_id])
}

model Order {
  order_id       Int       @id @default(autoincrement())
  order_no       String    @unique
  order_date     DateTime
  order_channel  String?
  customer_id    Int
  status         String?
  payment_status String?
  remarks        String?

  customer   Customer   @relation(fields: [customer_id], references: [customer_id])
  items      OrderItem[]
  dispatches Dispatch[]
  invoices   Invoice[]
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  order_id      Int
  product_id    Int
  pack_size     Float
  pack_unit     String
  qty_packs     Int
  rate_per_unit Float
  line_total    Float

  order   Order   @relation(fields: [order_id], references: [order_id])
  product Product @relation(fields: [product_id], references: [product_id])
}

model Dispatch {
  dispatch_id       Int       @id @default(autoincrement())
  dispatch_no       String    @unique
  dispatch_date     DateTime
  order_id          Int?
  customer_id       Int
  transport_details String?
  status            String?
  remarks           String?

  order    Order?   @relation(fields: [order_id], references: [order_id])
  customer Customer @relation(fields: [customer_id], references: [customer_id])
}

model Invoice {
  invoice_id     Int       @id @default(autoincrement())
  invoice_no     String    @unique
  invoice_date   DateTime
  customer_id    Int
  order_id       Int?
  gross_total    Float
  discount       Float     @default(0)
  tax_percent    Float     @default(0)
  tax_amount     Float     @default(0)
  net_amount     Float
  payment_status String?
  payment_date   DateTime?
  payment_mode   String?
  remarks        String?

  customer Customer @relation(fields: [customer_id], references: [customer_id])
  order    Order?   @relation(fields: [order_id], references: [order_id])
}

model Return {
  return_id         Int      @id @default(autoincrement())
  return_date       DateTime
  source_type       String
  source_ref        String?
  product_id        Int
  pack_size         Float
  pack_unit         String
  qty_packs         Int
  reason            String?
  adjusted_in_stock Boolean @default(false)
  remarks           String?

  product Product @relation(fields: [product_id], references: [product_id])
}


